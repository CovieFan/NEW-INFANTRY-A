{
  // 工程级配置：不含绝对路径、不含工程名，移动/复制/改名文件后无需修改本文件
  // 工具链（gcc/gdb/openocd/cmake）路径统一放在用户级 settings.json
  // 产物名统一为 firmware.elf（见 CMakeLists.txt 的 OUTPUT_NAME）
  "cmake.useCMakePresets": "always",
  "cmake.configureOnOpen": true,
  "cmake.configurePreset": "Debug",
  "cmake.buildPreset": "Debug",

  // ★ 主来源：CMake 生成的编译数据库，随目录结构自动更新
  "C_Cpp.default.compileCommands": "${workspaceFolder}/build/Debug/compile_commands.json",
  "C_Cpp.default.intelliSenseMode": "windows-gcc-arm",
  "C_Cpp.default.cStandard": "c11",

  // ★ 兜底：数据库缺失/过期时，递归通配符仍可解析任意层级的头文件
  "C_Cpp.default.includePath": [
    "${workspaceFolder}/USER/**",
    "${workspaceFolder}/Core/Inc",
    "${workspaceFolder}/Drivers/**"
  ],
  // ★ 索引范围覆盖整棵树：新增/移动子目录都不用改这里
  "C_Cpp.default.browse.path": [
    "${workspaceFolder}/USER",
    "${workspaceFolder}/Core"
  ],

  "files.associations": {
    "*.s": "asm",
    "*.ld": "linkerscript",
    "*.ioc": "plaintext"
  },
  "files.exclude": {
    "**/build/*": true
  },
  "search.exclude": {
    "**/build": true,
    "**/Drivers": true
  },
  "files.watcherExclude": {
    "**/build/**": true,
    "**/Drivers/**": true,
    "**/.git/objects/**": true
  }
}
