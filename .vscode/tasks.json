{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "配置 (Debug)",
      "type": "shell",
      "command": "cmake",
      "args": ["--preset", "Debug"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "构建",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "--preset", "Debug"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "构建 (Release)",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "--preset", "Release"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "清理重建 (Debug)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-Command",
        "Remove-Item -Recurse -Force '${workspaceFolder}/build/Debug' -ErrorAction SilentlyContinue; cmake --preset Debug; cmake --build --preset Debug"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "烧录前自检",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-Command",
        "$e = Get-Item 'build/Debug/firmware.elf' -ErrorAction Stop; $n = @(Get-ChildItem USER,Core -Recurse -Include *.c,*.h | Where-Object { $_.LastWriteTime -gt $e.LastWriteTime }).Count; if ($n -gt 0) { throw \"有 $n 个源文件比 ELF 新，请先构建\" }; Write-Host \"烧录目标: $($e.FullName)\"; Write-Host \"ELF 时间: $($e.LastWriteTime)\""
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "烧录 (Debug)",
      "type": "shell",
      "command": "${config:cortex-debug.openocdPath}",
      "args": [
        "-f", "openocd/daplink.cfg",
        "-c", "program build/Debug/firmware.elf verify reset exit"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": ["构建", "烧录前自检"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "查看实际参与编译的源文件",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-Command",
        "(Get-Content 'build/Debug/compile_commands.json' -Raw | ConvertFrom-Json).file | Sort-Object -Unique"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
